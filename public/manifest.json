{
  "manifest_version": 3,
  "name": "Flipbook — CS2 trade journal for CSFloat",
  "short_name": "Flipbook",
  "version": "0.1.0",
  "description": "Pairs your CSFloat buys with your sells and shows what every flip made. Data stays on your machine.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Flipbook",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://csfloat.com/*"
  ]
}
